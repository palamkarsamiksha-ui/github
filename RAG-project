        "\n",
        "from google.colab import files\n",
        "from pypdf import PdfReader\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.metrics.pairwise import cosine_similarity\n",
        "\n",
        "# 1. Upload your PDF\n",
        "uploaded = files.upload()\n",
        "pdf_path = next(iter(uploaded))\n",
        "\n",
        "# 2. Read PDF text\n",
        "reader = PdfReader(pdf_path)\n",
        "text = \"\\n\".join(page.extract_text() or \"\" for page in reader.pages)\n",
        "\n",
        "if not text.strip():\n",
        "    raise ValueError(\"No text found. Please use a text-based PDF.\")\n",
        "\n",
        "print(\"PDF loaded successfully!\")\n",
        "print(\"Pages:\", len(reader.pages))\n",
        "print(\"Characters:\", len(text))\n",
        "\n",
        "# 3. Split text into chunks\n",
        "chunks = [\n",
        "    text[i:i + 1000]\n",
        "    for i in range(0, len(text), 850)\n",
        "    if text[i:i + 1000].strip()\n",
        "]\n",
        "\n",
        "# 4. Create the search system\n",
        "vectorizer = TfidfVectorizer(stop_words=\"english\")\n",
        "vectors = vectorizer.fit_transform(chunks)\n",
        "\n",
        "print(\"RAG search system is ready!\")\n",
        "\n",
        "# 5. Ask questions\n",
        "while True:\n",
        "    question = input(\"\\nAsk about your PDF (type exit to stop): \")\n",
        "\n",
        "    if question.lower() == \"exit\":\n",
        "        print(\"Project finished!\")\n",
        "        break\n",
        "\n",
        "    query_vector = vectorizer.transform([question])\n",
        "    scores = cosine_similarity(query_vector, vectors).flatten()\n",
        "    best = scores.argmax()\n",
        "\n",
        "    if scores[best] == 0:\n",
        "        print(\"No relevant information found in the PDF.\")\n",
        "    else:\n",
        "        print(\"\\nRelevant answer from your PDF:\")\n",
        "        print(chunks[best])\n"
      ]
